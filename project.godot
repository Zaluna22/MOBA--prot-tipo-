; Engine configuration file.
config_version=5

[application]

config/icon="res://icon.png"
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/show_image=true

config/name="MOBA Prototipo 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.1, 0.18, 0.11, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/16_bits=true

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=4
